{
  "name": "smak",
  "version": "0.39.0",
  "description": "SMAK, the Studio Model Agent Kit: GoldSrc studio models (.mdl) and maps (.bsp, .map, .wad) read, made, changed, checked and drawn from Node, by an AI agent, with no decompiler, no studiomdl and no dependencies.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./workshop": "./src/workshop.mjs",
    "./maps": "./src/maps/index.mjs",
    "./play": "./src/play.mjs",
    "./animate": "./src/animate.mjs",
    "./kits/*": "./kits/*.mjs",
    "./src/*": "./src/*.mjs"
  },
  "bin": {
    "smak": "bin/smak.mjs"
  },
  "scripts": {
    "test": "node test/selftest.mjs",
    "format": "npx prettier@3.3.3 --write \"**/*.mjs\""
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    ".prettierrc.json",
    "bin",
    "levels",
    "src",
    "kits",
    "viewer",
    "mcp",
    "examples",
    "profiles",
    "docs",
    "test",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/agents",
    "LICENSE"
  ],
  "keywords": [
    "goldsrc",
    "half-life",
    "xash3d",
    "mdl",
    "studiomdl",
    "modding"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "recast-navigation": "^0.44.0"
  }
}
