{
  "name": "smak",
  "version": "1.0.1",
  "description": "SMAK, the Studio Model Agent Kit: GoldSrc studio models (.mdl) and maps (.bsp, .map, .wad) read, made, changed, checked and drawn from Node, by an AI agent, with no decompiler, no studiomdl and no dependencies.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./workshop": "./make/workshop.mjs",
    "./maps": "./check/maps/index.mjs",
    "./play": "./cli/play.mjs",
    "./animate": "./make/animate.mjs",
    "./kits/*": "./kits/*.mjs",
    "./src/*": "./src/*.mjs",
    "./core/*": "./core/*.mjs",
    "./make/*": "./make/*.mjs",
    "./check/*": "./check/*.mjs",
    "./cli/*": "./cli/*.mjs"
  },
  "bin": {
    "smak": "bin/smak.mjs"
  },
  "scripts": {
    "test": "node test/selftest.mjs",
    "test:slow": "node test/selftest.mjs --slow",
    "format": "npx prettier@3.3.3 --write \"**/*.mjs\""
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    ".prettierrc.json",
    "bin",
    "core",
    "make",
    "check",
    "cli",
    "src",
    "kits",
    "examples",
    "profiles",
    "docs",
    "test",
    "layers.json",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/agents",
    "LICENSE"
  ],
  "keywords": [
    "goldsrc",
    "half-life",
    "xash3d",
    "mdl",
    "studiomdl",
    "modding"
  ],
  "license": "MIT",
  "private": true
}
