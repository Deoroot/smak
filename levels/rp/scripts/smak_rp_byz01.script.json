{
  "format": "smak-script/1",
  "map": "smak_rp_byz01",
  "note": "Dialogue for byz01. The merchant, medic, mechanic and barman rules bind to the people smak_npc generates (stable ids: <role>_<place id>, see levels/rp/plugin/include/smak_npc.inc); a menu opens when a player uses that person while ducking. smak_npc.amxx must be listed before smak_script.amxx. Say and hour rules are heard anywhere. Use standing is smak_rp missions. No accents.",
  "rules": [
    {
      "id": "ms1_door_back", "on": "use", "npc": "shopkeeper_ms1_shop", "duck": true, "speaker": "Mercader del Foro",
      "if": [ { "flag": "met_merchant" } ],
      "do": [
        { "say": "Otra vez tu, {jugador}. Mira, que hoy hay de todo." },
        { "open_menu": { "title": "Mercader del Foro Menor", "options": [
          { "text": "Ver la mercancia", "do": [ { "open_shop": "mercado" } ] },
          { "text": "Quien manda en el Hipodromo?",
            "if": [ { "no_flag": "heard_factions" } ],
            "do": [ { "say": "Azules y Verdes se pelean por las carreras. Los relojes cuentan las vueltas." }, { "set_flag": "heard_factions" } ] },
          { "text": "Nada, gracias", "do": [ { "say": "Que la Virgen te guarde." } ] }
        ] } }
      ]
    },
    {
      "id": "ms1_door_first", "on": "use", "npc": "shopkeeper_ms1_shop", "duck": true, "speaker": "Mercader del Foro",
      "do": [
        { "say": "Bienvenido al Foro Menor. Sin papeles no se compra bien." },
        { "set_flag": "met_merchant" },
        { "open_menu": { "title": "Mercader del Foro Menor", "options": [
          { "text": "Ver la mercancia", "do": [ { "open_shop": "mercado" } ] },
          { "text": "Que se vende aqui?",
            "do": [ { "say": "Vendas, ampollas azules y chatarra de relojero. Y papeles del Mese." } ] },
          { "text": "Nada, gracias", "do": [ { "say": "Vuelve cuando tengas monedas." } ] }
        ] } }
      ]
    },
    {
      "id": "clinic_door_night", "on": "use", "npc": "medic_clinic_clinic", "duck": true, "speaker": "Medico del Hilo de Bronce",
      "if": [ { "hour": [20, 24] } ],
      "do": [
        { "say": "Es tarde, pero un herido no espera. Pasa, {jugador}." },
        { "open_menu": { "title": "Dispensario", "options": [
          { "text": "Ver los remedios", "do": [ { "open_shop": "dispensario" } ] },
          { "text": "Nada, gracias", "do": [ { "say": "Descansa. La noche es larga." } ] }
        ] } }
      ]
    },
    {
      "id": "clinic_door", "on": "use", "npc": "medic_clinic_clinic", "duck": true, "speaker": "Medico del Hilo de Bronce",
      "do": [
        { "say": "Buenos dias. Hilos de bronce y alcohol, como manda el gremio." },
        { "open_menu": { "title": "Dispensario", "options": [
          { "text": "Ver los remedios", "do": [ { "open_shop": "dispensario" } ] },
          { "text": "Que son los hilos de bronce?",
            "do": [ { "say": "Mejoras de los relojeros: nervios de cobre. Duelen, pero corres mas." }, { "set_flag": "heard_implants" } ] },
          { "text": "Nada, gracias", "do": [ { "say": "Cuidate." } ] }
        ] } }
      ]
    },
    {
      "id": "works_door_smith", "on": "use", "npc": "mechanic_works_workshop", "duck": true, "speaker": "Maestro Relojero",
      "if": [ { "flag": "heard_implants" } ],
      "do": [
        { "say": "Te manda el medico? Entonces hablamos de hierro y fuego." },
        { "open_menu": { "title": "Taller de Relojeria y Fuego", "options": [
          { "text": "Ver el taller", "do": [ { "open_shop": "taller" } ] },
          { "text": "Y el fuego griego?",
            "if": [ { "no_flag": "heard_fire" } ],
            "do": [ { "say": "Receta del Gremio. No la vendo, ni borracho. Pregunta a la Guardia." }, { "set_flag": "heard_fire" } ] },
          { "text": "Nada, gracias", "do": [ { "say": "Cierra al salir. Las ruedas no perdonan." } ] }
        ] } }
      ]
    },
    {
      "id": "works_door", "on": "use", "npc": "mechanic_works_workshop", "duck": true, "speaker": "Maestro Relojero",
      "do": [
        { "say": "Ruedas, resortes y alguna tuerca. Que buscas, {jugador}?" },
        { "open_menu": { "title": "Taller de Relojeria y Fuego", "options": [
          { "text": "Ver el taller", "do": [ { "open_shop": "taller" } ] },
          { "text": "Nada, gracias", "do": [ { "say": "Pues deja de mirar el engranaje." } ] }
        ] } }
      ]
    },
    {
      "id": "bar_door_fence", "on": "use", "npc": "barman_bar_bar", "duck": true, "speaker": "Cantinero del Hipodromo",
      "if": [ { "flag": "bar_round" } ],
      "do": [
        { "say": "Amigo de la casa. Si traes algo que no tiene dueno, lo miro." },
        { "open_menu": { "title": "Trastienda del Hipodromo", "options": [
          { "text": "Mercancia sin preguntas", "do": [ { "open_shop": "trastienda" } ] },
          { "text": "Chismes de la ciudad",
            "if": [ { "no_flag": "heard_curfew" } ],
            "do": [ { "say": "La Guardia cierra los puestos al toque de queda. Las calles son de los Verdes." }, { "set_flag": "heard_curfew" } ] },
          { "text": "Nada, gracias", "do": [ { "say": "Ni una palabra a nadie." } ] }
        ] } }
      ]
    },
    {
      "id": "bar_door_first", "on": "use", "npc": "barman_bar_bar", "duck": true, "speaker": "Cantinero del Hipodromo",
      "do": [
        { "say": "Vino de la cisterna y apuestas de carrera. Que te sirvo?" },
        { "open_menu": { "title": "Cantina del Hipodromo", "options": [
          { "text": "Pagar una ronda (10)",
            "if": [ { "money": 10 } ],
            "do": [ { "take_money": 10 }, { "set_flag": "bar_round" }, { "say": "Gracias. Ahora si hablamos: pregunta por la trastienda." } ] },
          { "text": "Pagar una ronda (10)",
            "if": [ { "no_flag": "bar_round" } ],
            "do": [ { "say": "Sin monedas no hay vino, {jugador}." } ] },
          { "text": "Quien gana las carreras?",
            "if": [ { "no_flag": "heard_factions" } ],
            "do": [ { "say": "Azules o Verdes, segun quien pague a los jueces." }, { "set_flag": "heard_factions" } ] },
          { "text": "Nada, gracias", "do": [ { "say": "Como quieras." } ] }
        ] } }
      ]
    },
    {
      "id": "say_greek_fire", "on": "say", "words": [ "fuego griego" ], "speaker": "Voz del mercado",
      "do": [ { "say": "El fuego griego arde sobre el agua. Solo el Gremio sabe hacerlo." }, { "cooldown": 20 } ]
    },
    {
      "id": "say_hippodrome", "on": "say", "words": [ "hipodromo", "carreras" ], "speaker": "Voz del mercado",
      "do": [ { "say": "Hoy corren los carros de bronce. Apuesta con cabeza." }, { "cooldown": 20 } ]
    },
    {
      "id": "say_guild", "on": "say", "words": [ "gremio", "relojeros" ], "speaker": "Voz del mercado",
      "do": [ { "say": "Los relojeros mandan en la torre. Sin sello del gremio no se abre un taller." }, { "cooldown": 20 } ]
    },
    {
      "id": "say_icon", "on": "say", "words": [ "icono", "iconos" ], "speaker": "Voz del mercado",
      "do": [ { "say": "Los iconos de oro vigilan las calles. Dicen que algunos tienen ojos de lente." }, { "cooldown": 20 } ]
    },
    {
      "id": "spawn_welcome", "on": "spawn", "speaker": "Pregonero",
      "if": [ { "no_flag": "seen_welcome" } ],
      "do": [
        { "say": "Bienvenido a Nueva Bizancio, {jugador}. Para hablar con un tendero, agachate y usa su puerta." },
        { "set_flag": "seen_welcome" }
      ]
    },
    {
      "id": "hour_7", "on": "hour", "hour": 7, "speaker": "Campana del Hipodromo",
      "do": [ { "say": "Suenan las campanas: abren los gremios y los puestos." } ]
    },
    {
      "id": "hour_12", "on": "hour", "hour": 12, "speaker": "Reloj de la torre",
      "do": [ { "say": "Mediodia. Los relojes de bronce dan doce tanidos." } ]
    },
    {
      "id": "hour_19", "on": "hour", "hour": 19, "speaker": "Farolero",
      "do": [ { "say": "Se encienden las lamparas de aceite. La cantina abre sus puertas." } ]
    },
    {
      "id": "hour_22", "on": "hour", "hour": 22, "speaker": "Guardia de la Nexus",
      "do": [ { "say": "Toque de queda. A casa, ciudadanos." } ]
    }
  ]
}
