{
  "format": "smak-script/1",
  "map": "smak_rp_mtest",
  "note": "Test of smak_script on the test map: Marco the Fixer (npc fixer). Use him DUCKING for this menu (standing, smak_rp's mission menu opens). No accents: the chat font may not draw them.",
  "rules": [
    {
      "id": "fixer_back", "on": "use", "npc": "fixer", "duck": true,
      "if": [ { "flag": "asked_work" } ],
      "do": [
        { "say": "Otra vez por aqui, {jugador}. Ya sabes lo del trabajo." },
        { "open_menu": { "title": "Marco, el intermediario", "options": [
          { "text": "Pedir un adelanto",
            "if": [ { "no_flag": "got_advance" } ],
            "do": [ { "give_money": 50 }, { "set_flag": "got_advance" }, { "say": "Cincuenta, y no se lo digas a nadie." } ] },
          { "text": "Ya me diste el adelanto",
            "if": [ { "flag": "got_advance" } ],
            "do": [ { "say": "Una vez. No soy un banco." } ] },
          { "text": "Nada, gracias",
            "do": [ { "say": "Como quieras." } ] }
        ] } }
      ]
    },
    {
      "id": "fixer_first", "on": "use", "npc": "fixer", "duck": true,
      "do": [
        { "say": "Hola, {jugador}. No te conozco. Si buscas trabajo, preguntame." },
        { "open_menu": { "title": "Marco, el intermediario", "options": [
          { "text": "Preguntar por trabajo",
            "do": [ { "say": "Hay faena en el patio del este. Pisa la baldosa verde y pulsa el boton del fondo." }, { "set_flag": "asked_work" } ] },
          { "text": "Nada, gracias",
            "do": [ { "say": "Como quieras." } ] }
        ] } }
      ]
    },
    {
      "id": "say_money", "on": "say", "words": [ "dame dinero", "dinero" ], "npc": "fixer", "radius": 400,
      "if": [ { "flag": "asked_work" }, { "no_flag": "got_advance" } ],
      "do": [ { "say": "Toma cincuenta. Solo una vez." }, { "give_money": 50 }, { "set_flag": "got_advance" } ]
    },
    {
      "id": "say_money_again", "on": "say", "words": [ "dame dinero", "dinero" ], "npc": "fixer", "radius": 400,
      "if": [ { "flag": "got_advance" } ],
      "do": [ { "say": "Ya te di tu adelanto, {jugador}." }, { "cooldown": 5 } ]
    },
    {
      "id": "say_money_early", "on": "say", "words": [ "dame dinero", "dinero" ], "npc": "fixer", "radius": 400,
      "do": [ { "say": "Primero pregunta por trabajo (agachado, usame)." }, { "cooldown": 5 } ]
    },
    {
      "id": "say_hello", "on": "say", "words": [ "hola", "buenas" ], "npc": "fixer", "radius": 400,
      "do": [ { "say": "Buenas. Para hablar de trabajo, agachate y pulsa usar sobre mi." }, { "cooldown": 10 } ]
    },
    {
      "id": "noon_line", "on": "hour", "hour": 12, "npc": "fixer", "radius": 3000,
      "do": [ { "say": "Es mediodia en la ciudad. Hora de comer." } ]
    }
  ]
}
